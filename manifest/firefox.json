{
  "browser_specific_settings": {
    "gecko": {
      "id": "extension@anyshortcut.com",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["*://*.anyshortcut.com/auth/success", "*://*.anyshortcut.com/account*"],
      "js": ["firefox-auth-helper.js"],
      "all_frames": false,
      "run_at": "document_idle"
    }
  ]
}
